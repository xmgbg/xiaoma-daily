<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape><solid android:color="@color/accent" /><corners android:radius="24dp" /></shape>
            </item>
            <item android:state_activated="true">
                <shape><stroke android:width="1dp" android:color="@color/accent" /><corners android:radius="24dp" /></shape>
            </item>
            <item><shape><solid android:color="@android:color/transparent" /></shape></item>
        </selector>
    </item>
</ripple>
