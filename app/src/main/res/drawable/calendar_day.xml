<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <layer-list><item android:width="36dp" android:height="36dp" android:gravity="center">
            <selector>
                <item android:state_selected="true"><shape android:shape="oval"><solid android:color="@color/accent" /></shape></item>
                <item android:state_activated="true"><shape android:shape="oval"><stroke android:width="1dp" android:color="@color/accent" /></shape></item>
                <item><shape><solid android:color="@android:color/transparent" /></shape></item>
            </selector>
        </item></layer-list>
    </item>
</ripple>
