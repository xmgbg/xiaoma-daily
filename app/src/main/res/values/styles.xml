<resources>
    <style name="Widget.Xiaoma.TextAction" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="Widget.Xiaoma.IconAction" parent="android:Widget.Material.ImageButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="Widget.Xiaoma.Tab" parent="Widget.Xiaoma.TextAction">
        <item name="android:textSize">12sp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/navigation_press</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
