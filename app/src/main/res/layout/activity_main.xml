<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/calendarPage"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="12dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/launcher_art" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:text="@string/app_name" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                <Button android:id="@+id/textSize" style="@style/Widget.Xiaoma.TextAction"
                    android:layout_width="48dp" android:layout_height="48dp" android:text="@string/font_symbol"
                    android:textColor="@color/text_primary" android:contentDescription="@string/text_size_title" />
                <ImageButton android:id="@+id/today" style="@style/Widget.Xiaoma.IconAction"
                    android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_compose"
                    android:contentDescription="@string/write_today" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center_vertical">
                <TextView android:id="@+id/month" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground"
                    android:fontFamily="sans-serif-medium" android:textSize="18sp" android:textColor="@color/text_primary" />
                <Button android:id="@+id/monthReset" style="@style/Widget.Xiaoma.TextAction"
                    android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/today_label" />
                <Button android:id="@+id/previous" style="@style/Widget.Xiaoma.TextAction"
                    android:layout_width="48dp" android:layout_height="48dp" android:text="@string/previous_symbol"
                    android:textSize="24sp" android:textColor="@color/text_primary" android:contentDescription="@string/previous_month" />
                <Button android:id="@+id/next" style="@style/Widget.Xiaoma.TextAction"
                    android:layout_width="48dp" android:layout_height="48dp" android:text="@string/next_symbol"
                    android:textSize="24sp" android:textColor="@color/text_primary" android:contentDescription="@string/next_month" />
            </LinearLayout>
            <GridLayout android:id="@+id/calendar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:columnCount="7" />
            <TextView android:id="@+id/reportCount" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="13sp" android:textColor="@color/text_secondary" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="20dp" android:background="@color/divider" />
            <TextView android:id="@+id/selectedDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical"
                android:background="@drawable/surface_group">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/day_report" android:textSize="14sp" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary" />
                <TextView android:id="@+id/selectedSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end"
                    android:lineSpacingExtra="4dp" android:textSize="16sp" android:textColor="@color/text_primary" />
                <Button android:id="@+id/selectedAction" style="@style/Widget.Xiaoma.TextAction"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:paddingStart="0dp"
                    android:text="@string/write_day_short" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="8dp"
        android:orientation="horizontal" android:baselineAligned="false" android:background="@drawable/navigation_background">
        <Button android:id="@+id/navCalendar" style="@style/Widget.Xiaoma.Tab"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/nav_calendar" android:drawableTop="@drawable/ic_calendar"
            android:textColor="@color/accent" android:drawableTint="@color/accent" />
        <Button android:id="@+id/navMine" style="@style/Widget.Xiaoma.Tab"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/nav_mine" android:drawableTop="@drawable/ic_person"
            android:textColor="@color/text_secondary" android:drawableTint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
