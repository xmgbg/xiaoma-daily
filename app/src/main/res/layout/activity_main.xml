<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="80dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="24dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/app_name" android:textSize="28sp"
                        android:textStyle="bold" android:textColor="@color/text_primary"
                        android:accessibilityHeading="true" />
                    <Button android:id="@+id/textSize" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:minWidth="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/text_size" android:textAllCaps="false"
                        android:textColor="@color/accent" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:gravity="center_vertical">
                    <Button android:id="@+id/previous" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/previous_symbol" android:textAllCaps="false" android:textSize="28sp"
                        android:textColor="@color/text_primary" android:contentDescription="@string/previous_month" />
                    <TextView android:id="@+id/month" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center" android:clickable="true"
                        android:focusable="true" android:background="?android:attr/selectableItemBackground"
                        android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/next" android:layout_width="48dp" android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/next_symbol" android:textAllCaps="false" android:textSize="28sp"
                        android:textColor="@color/text_primary" android:contentDescription="@string/next_month" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fillViewport="true" android:layout_marginTop="16dp" android:scrollbars="none">
                    <GridLayout android:id="@+id/calendar" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minWidth="336dp" android:columnCount="7" />
                </HorizontalScrollView>
                <TextView android:id="@+id/reportCount" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:text="@string/no_reports" android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:background="@color/divider" />
                <TextView android:id="@+id/selectedDate" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/selectedSummary" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:maxLines="2" android:ellipsize="end" android:text="@string/empty_day"
                        android:textSize="16sp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/selectedAction" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:layout_marginStart="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/write_day_short" android:textAllCaps="false"
                        android:textSize="14sp" android:textColor="@color/accent" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <Button android:id="@+id/today" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="bottom|end" android:layout_margin="20dp"
            android:background="@drawable/fab_background" android:elevation="5dp"
            android:text="@string/add_symbol" android:textSize="32sp" android:textAllCaps="false"
            android:textColor="@color/on_accent" android:contentDescription="@string/write_today" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:baselineAligned="false" android:background="@color/surface_elevated"
        android:elevation="4dp">
        <LinearLayout android:id="@+id/navCalendar" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_calendar" android:tint="@color/accent"
                android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/nav_calendar" android:textSize="12sp"
                android:textColor="@color/accent" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navMine" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/nav_mine">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_person" android:tint="@color/text_secondary"
                android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/nav_mine" android:textSize="12sp"
                android:textColor="@color/text_secondary" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
