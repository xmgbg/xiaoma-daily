<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <Button android:id="@+id/back" style="@style/Widget.Xiaoma.TextAction"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/back_calendar"
            android:textColor="@color/text_primary" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/editAction" style="@style/Widget.Xiaoma.TextAction"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/edit_short" />
        <Button android:id="@+id/more" style="@style/Widget.Xiaoma.TextAction"
            android:layout_width="48dp" android:layout_height="48dp" android:text="@string/more_symbol"
            android:textColor="@color/text_primary" android:textSize="24sp" android:contentDescription="@string/more_actions" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="28dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/dateMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/text_secondary" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="20dp" android:background="@color/divider" />
            <TextView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/empty_day" android:textSize="16sp"
                android:lineSpacingExtra="8dp" android:textColor="@color/text_primary" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/write" style="@style/Widget.Xiaoma.TextAction"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="@drawable/navigation_background" android:elevation="2dp"
        android:drawableStart="@drawable/ic_compose" android:drawableTint="@color/accent" android:drawablePadding="8dp"
        android:text="@string/write_day" />
</LinearLayout>
