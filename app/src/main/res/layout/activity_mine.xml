<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/mine_title" android:textSize="28sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:accessibilityHeading="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:orientation="vertical" android:gravity="center_horizontal">
                <ImageView android:id="@+id/avatar" android:layout_width="96dp" android:layout_height="96dp"
                    android:background="@drawable/avatar_background" android:clipToOutline="true"
                    android:scaleType="centerCrop" android:src="@drawable/launcher_art"
                    android:contentDescription="@string/avatar_description" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/avatar_title"
                    android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:gravity="center" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/avatar_local"
                    android:textSize="14sp" android:textColor="@color/text_secondary" android:gravity="center" />
                <Button android:id="@+id/changeAvatar" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:layout_marginTop="16dp"
                    android:text="@string/change_avatar" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="40dp" android:text="@string/backup_title"
                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/backup_description"
                android:textSize="15sp" android:textColor="@color/text_secondary" />
            <Button android:id="@+id/exportReports" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="20dp"
                android:text="@string/export_reports" android:backgroundTint="@color/accent"
                android:textColor="@color/on_accent" />
            <Button android:id="@+id/importReports" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="8dp"
                android:text="@string/import_reports" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:background="@color/surface" android:elevation="4dp">
        <Button android:id="@+id/navCalendar" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="?android:attr/selectableItemBackground"
            android:text="@string/nav_calendar" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/navMine" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="?android:attr/selectableItemBackground"
            android:text="@string/nav_mine" android:textColor="@color/accent" />
    </LinearLayout>
</LinearLayout>
